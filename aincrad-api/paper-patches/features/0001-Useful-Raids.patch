From: Peter Pan <peter@never.lan>
Date: Tue, 9 Jun 2026 22:06:16 -0400
Subject: [PATCH] Useful Raids


diff --git a/src/main/java/org/bukkit/Raid.java b/src/main/java/org/bukkit/Raid.java
index 4dfc2bc66c37edf16dfc9ceeac17305996c83e74..2f509ca89f8b62e54c108b188e286f505d503692 100644
--- a/src/main/java/org/bukkit/Raid.java
+++ b/src/main/java/org/bukkit/Raid.java
@@ -157,4 +157,27 @@ public interface Raid extends PersistentDataHolder {
          */
         STOPPED;
     }
+
+    // Aincrad start
+    /**
+     * Forcibly ends this raid with the given outcome, firing {@link org.bukkit.event.raid.RaidFinishEvent}.
+     * <p>
+     * If {@code victory} is {@code true}, Hero of the Village is awarded to all heroes
+     * and the vanilla victory path is followed. If {@code false}, the raid ends as a loss.
+     * <p>
+     * Has no effect if the raid is not {@link RaidStatus#ONGOING}.
+     *
+     * @param victory {@code true} for a victory outcome, {@code false} for a loss
+     */
+    void forceStop(boolean victory);
+
+    /**
+     * Returns whether this raid was started via the plugin API rather than the vanilla
+     * Bad Omen trigger. Plugin-controlled raids do not terminate when the center block
+     * position is no longer inside a village.
+     *
+     * @return {@code true} if this is a plugin-controlled raid
+     */
+    boolean isPluginControlled();
+    // Aincrad end
 }
diff --git a/src/main/java/org/bukkit/World.java b/src/main/java/org/bukkit/World.java
index b202bdb84bae23f7b2b5af591879a032f6378a25..f2e0f734363345036960759de0d2c4231e0fcd76 100644
--- a/src/main/java/org/bukkit/World.java
+++ b/src/main/java/org/bukkit/World.java
@@ -4442,6 +4442,27 @@ public interface World extends RegionAccessor, WorldInfo, PluginMessageRecipient
     @Nullable Raid getRaid(int id);
     // Paper end - more Raid API
 
+    // Aincrad start
+    /**
+     * Creates a new raid centered at the given location, triggered by the given player.
+     * <p>
+     * Unlike the vanilla trigger, this bypasses the village POI check — the raid will not
+     * stop due to {@link org.bukkit.event.raid.RaidStopEvent.Reason#NOT_IN_VILLAGE} when
+     * {@code pluginControlled} is {@code true}.
+     * <p>
+     * {@link org.bukkit.event.raid.RaidTriggerEvent} is still fired and may cancel creation.
+     * The difficulty and 40-minute timeout still apply.
+     *
+     * @param player          the player triggering the raid (must not be a spectator)
+     * @param location        the center of the raid
+     * @param badOmenLevel    the Bad Omen level (0–5)
+     * @param pluginControlled whether to skip village validation during the raid's lifetime
+     * @return the created {@link Raid}, or {@code null} if creation failed or was cancelled
+     */
+    @Nullable
+    Raid createRaid(@NotNull org.bukkit.entity.Player player, @NotNull Location location, int badOmenLevel, boolean pluginControlled);
+    // Aincrad end
+
     /**
      * Gets all raids that are going on over this world.
      *
