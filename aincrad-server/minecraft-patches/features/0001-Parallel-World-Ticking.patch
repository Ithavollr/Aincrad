-            profilerFiller.pop();
-            serverLevel.explosionDensityCache.clear(); // Paper - Optimize explosions
+            // Block on each world's future in submission order; futures that are already
+            // done return immediately, so this exits as soon as the last world finishes.
+            long deadline = Util.getNanos() + 150000000L; // 150ms max timeout, 50mspt is the target
+            for (com.mojang.datafixers.util.Pair<java.util.concurrent.Future<ServerLevel>, ServerLevel> pair : tasks) {
+                java.util.concurrent.Future<ServerLevel> future = pair.getFirst();
+                final net.minecraft.server.level.ServerLevel level = pair.getSecond();
+                try {
+                    future.get(Math.max(deadline - Util.getNanos(), 0L), java.util.concurrent.TimeUnit.NANOSECONDS);
+                } catch (java.util.concurrent.TimeoutException e) {
+                    // Log the problem world, then block on it until it finishes:
+                    LOGGER.warn("[World Ticking] tickChildren watchdog activated! Blocking on ticking world: " + level);
+                    try {
+                        future.get();
+                    } catch (InterruptedException | java.util.concurrent.ExecutionException e2) {
+                        throw new RuntimeException("[World Ticking] Exception during blocking parallel world tick for " + level.toString(), e2);
+                    }
+                } catch (InterruptedException | java.util.concurrent.ExecutionException e) {
+                    throw new RuntimeException("[World Ticking] Exception during parallel world tick for " + level.toString(), e);
+                }
+            }
+        } catch (java.lang.RuntimeException e) {
+            throw new RuntimeException(e); // Propagate exception
         }
