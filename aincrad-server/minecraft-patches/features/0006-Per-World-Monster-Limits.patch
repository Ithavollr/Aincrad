From: Peter Pan <peter@never.lan>
Date: Wed, 27 May 2026 23:44:05 -0400
Subject: [PATCH] Per World Monster Limits


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 764d176bba7d3966d31fbc79d56634f8ccdd9632..924594a941f3b5425bb35b873544dfda414b2af3 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -1666,6 +1666,18 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
         return this.getEntities(EntityType.ENDER_DRAGON, LivingEntity::isAlive);
     }
 
+    public int getEntityCount(Class<? extends Entity> entityClass) {
+        return this.entityCountsByType.getOrDefault(entityClass, 0);
+    }
+
+    private void incrementEntityCount(Class<? extends Entity> entityClass) {
+        this.entityCountsByType.merge(entityClass, 1, Integer::sum);
+    }
+
+    private void decrementEntityCount(Class<? extends Entity> entityClass) {
+        this.entityCountsByType.computeIfPresent(entityClass, (k, v) -> v > 1 ? v - 1 : null);
+    }
+
     public List<ServerPlayer> getPlayers(Predicate<? super ServerPlayer> predicate) {
         return this.getPlayers(predicate, Integer.MAX_VALUE);
     }
@@ -2954,6 +2966,11 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
                 for (EnderDragonPart enderDragonPart : enderDragon.getSubEntities()) {
                     ServerLevel.this.dragonParts.put(enderDragonPart.getId(), enderDragonPart);
                 }
+                ServerLevel.this.incrementEntityCount(net.minecraft.world.entity.boss.enderdragon.EnderDragon.class);
+            }
+
+            if (entity instanceof net.minecraft.world.entity.monster.Giant) {
+                ServerLevel.this.incrementEntityCount(net.minecraft.world.entity.monster.Giant.class);
             }
 
             entity.updateDynamicGameEventListener(DynamicGameEventListener::add);
@@ -3025,6 +3042,11 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
                 for (EnderDragonPart enderDragonPart : enderDragon.getSubEntities()) {
                     ServerLevel.this.dragonParts.remove(enderDragonPart.getId());
                 }
+                ServerLevel.this.decrementEntityCount(net.minecraft.world.entity.boss.enderdragon.EnderDragon.class);
+            }
+
+            if (entity instanceof net.minecraft.world.entity.monster.Giant) {
+                ServerLevel.this.decrementEntityCount(net.minecraft.world.entity.monster.Giant.class);
             }
 
             entity.updateDynamicGameEventListener(DynamicGameEventListener::remove);
