+    public static boolean isUpgraded(ItemStack stack) {
+        CustomData customData = stack.getOrDefault(DataComponents.CUSTOM_DATA, CustomData.EMPTY);
+        CompoundTag check = new CompoundTag();
+        check.putBoolean("PotionHasBeenUpgraded", true); // build the comparision flag
+        if (customData.matchedBy(check)) return true; // compare flag against existing NBT data
+        Optional<Holder<Potion>> potion = stack.getOrDefault(DataComponents.POTION_CONTENTS, PotionContents.EMPTY).potion();
+        if (potion.isEmpty()) return false;
+        ResourceLocation key = potion.get().unwrapKey().map(ResourceKey::location).orElse(null);
+        if (key == null) return false;
+        String path = key.getPath();
+        return path.startsWith("long_") || path.startsWith("strong_");
+    }
+
+    public static void markUpgraded(ItemStack stack) {
+        CustomData.update(DataComponents.CUSTOM_DATA, stack, tag -> tag.putBoolean("PotionHasBeenUpgraded", true));
+    }
