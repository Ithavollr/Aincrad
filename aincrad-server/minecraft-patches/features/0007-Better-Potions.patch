+    // Aincrad start - custom potion brewing
+    private boolean hasAincradMix(ItemStack reagent, ItemStack potionItem) {
+        PotionContents contents = reagent.getOrDefault(DataComponents.POTION_CONTENTS, PotionContents.EMPTY);
+        // Base brew: AWKWARD + BASE_RECIPES ingredient
+        if (contents.is(Potions.AWKWARD) && BASE_RECIPES.containsKey(potionItem.getItem())) return true;
+        // Upgrade: custom-effect potion OR registry base potion + Redstone or Glowstone
+        if (!isUpgraded(reagent)) {
+            List<MobEffectInstance> effects = contents.customEffects();
+            if (effects.isEmpty() && contents.potion().isPresent()) {
+                effects = contents.potion().get().value().getEffects();
+            }
+            if (!effects.isEmpty()) {
+                // Redstone: allowed if not all effects are instant
+                if (potionItem.is(Items.REDSTONE) && !effects.stream().allMatch(e -> e.getEffect().value().isInstantenous())) {
+                    return true;
+                }
+                // Glowstone: allowed if all effects are amplifiable
+                if (potionItem.is(Items.GLOWSTONE_DUST) && effects.stream().allMatch(e -> AMPLIFIABLE_EFFECTS.contains(e.getEffect()))) {
+                    return true;
+                }
+            }
+        }
+        // Inversion: single-effect, un-upgraded potion + Fermented Spider Eye
+        if (potionItem.is(Items.FERMENTED_SPIDER_EYE) && !isUpgraded(reagent)) {
+            List<MobEffectInstance> effects = contents.customEffects();
+            if (effects.isEmpty() && contents.potion().isPresent()) {
+                effects = contents.potion().get().value().getEffects();
+            }
+            if (effects.size() == 1) {
+                MobEffectInstance effect = effects.get(0);
+                // SATURATION: only invert if amplifier >= 0 (saturation -> hunger)
+                if (effect.getEffect() == MobEffects.SATURATION && effect.getAmplifier() < 0) return false;
+                if (INVERSION_RECIPES.containsKey(effect.getEffect())) return true;
+            }
+        }
+        // Container mixes: gunpowder (potion->splash) and dragon's breath (splash->lingering) for custom potions
+        if (!contents.customEffects().isEmpty()) {
+            if (potionItem.is(Items.GUNPOWDER) && reagent.is(Items.POTION)) return true;
+            if (potionItem.is(Items.DRAGON_BREATH) && reagent.is(Items.SPLASH_POTION)) return true;
+        }
+        return false;
+    }
