+    // Aincrad start - more Raid API
+    public @Nullable Raid createRaid(ServerPlayer player, BlockPos pos, int badOmenLevel, boolean pluginControlled) {
+        if (player.isSpectator()) {
+            return null;
+        }
+        ServerLevel serverLevel = player.level();
+        if (!serverLevel.getGameRules().get(GameRules.RAIDS)) {
+            return null;
+        } else if (!serverLevel.environmentAttributes().getValue(EnvironmentAttributes.CAN_START_RAID, pos)) {
+            return null;
+        }
+
+        Raid raid = this.getOrCreateRaid(serverLevel, pos);
+
+        if (!org.bukkit.craftbukkit.event.CraftEventFactory.callRaidTriggerEvent(serverLevel, raid, player)) {
+            return null;
+        }
+
+        if (!this.raidMap.containsValue(raid)) {
+            this.raidMap.put(this.getUniqueId(), raid);
+        }
+
+        raid.setRaidOmenLevel(badOmenLevel);
+        raid.pluginControlled = pluginControlled;
+        this.setDirty();
+        return raid;
+    }
+    // Aincrad end - more Raid API
+
     private Raid getOrCreateRaid(ServerLevel level, BlockPos pos) {
         Raid raidAt = level.getRaidAt(pos);
         return raidAt != null ? raidAt : new Raid(pos, level.getDifficulty());
