+    class IllusionerStrafeGoal extends Goal {
+        private static final double SPEED_MODIFIER = 0.5;
+        private static final float ATTACK_RADIUS = 15.0F;
+        private static final float ATTACK_RADIUS_SQR = ATTACK_RADIUS * ATTACK_RADIUS;
+        private int seeTime;
+        private boolean strafingClockwise;
+        private boolean strafingBackwards;
+        private int strafingTime = -1;
+
+        @Override
+        public boolean canUse() {
+            return Illusioner.this.getTarget() != null && !Illusioner.this.isCastingSpell();
+        }
+
+        @Override
+        public boolean canContinueToUse() {
+            return this.canUse() || !Illusioner.this.getNavigation().isDone();
+        }
+
+        @Override
+        public void start() {
+            super.start();
+            Illusioner.this.setAggressive(true);
+        }
+
+        @Override
+        public void stop() {
+            super.stop();
+            Illusioner.this.setAggressive(false);
+            this.seeTime = 0;
+        }
+
+        @Override
+        public boolean requiresUpdateEveryTick() {
+            return true;
+        }
+
+        @Override
+        public void tick() {
+            LivingEntity target = Illusioner.this.getTarget();
+            if (target != null) {
+                double d = Illusioner.this.distanceToSqr(target.getX(), target.getY(), target.getZ());
+                boolean hasLineOfSight = Illusioner.this.getSensing().hasLineOfSight(target);
+                boolean flag = this.seeTime > 0;
+                if (hasLineOfSight != flag) {
+                    this.seeTime = 0;
+                }
+
+                if (hasLineOfSight) {
+                    this.seeTime++;
+                } else {
+                    this.seeTime--;
+                }
+
+                if (!(d > ATTACK_RADIUS_SQR) && this.seeTime >= 20) {
+                    Illusioner.this.getNavigation().stop();
+                    this.strafingTime++;
+                } else if (d > ATTACK_RADIUS_SQR * 0.3F){
+                    Illusioner.this.getNavigation().moveTo(target, SPEED_MODIFIER);
+                    this.strafingTime = -1;
+                }
+
+                if (this.strafingTime >= 20) {
+                    if (Illusioner.this.getRandom().nextFloat() < 0.3) {
+                        this.strafingClockwise = !this.strafingClockwise;
+                    }
+
+                    if (Illusioner.this.getRandom().nextFloat() < 0.3) {
+                        this.strafingBackwards = !this.strafingBackwards;
+                    }
+
+                    this.strafingTime = 0;
+                }
+
+                if (this.strafingTime > -1) {
+                    if (d > ATTACK_RADIUS_SQR * 0.75F) {
+                        this.strafingBackwards = false;
+                    } else if (d < ATTACK_RADIUS_SQR * 0.25F) {
+                        this.strafingBackwards = true;
+                    }
+
+                    Illusioner.this.getMoveControl().strafe(this.strafingBackwards ? -0.7F : 0.5F, this.strafingClockwise ? 0.2F : -0.5F);
+                    if (Illusioner.this.getControlledVehicle() instanceof Mob mob) {
+                        mob.lookAt(target, 30.0F, 30.0F);
+                    }
+
+                    Illusioner.this.lookAt(target, 30.0F, 30.0F);
+                } else {
+                    Illusioner.this.getLookControl().setLookAt(target, 30.0F, 30.0F);
+                }
+            }
+        }
     }
