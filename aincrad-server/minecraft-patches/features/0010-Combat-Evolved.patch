@@ -465,6 +465,23 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     // Paper end - rewrite chunk system
     public boolean hasTickedAtLeastOnceInNewWorld = false; // SparklyPaper - parallel world ticking (fixes bug in DreamResourceReset where the inventory is opened AFTER the player has changed worlds, if you click with the quick tp torch in a chest, because the inventory is opened AFTER the player has teleported)
 
+    // Aincrad start - off-hand interaction suppression
+    // A custom main-hand item action (e.g. the Wind Burst axe firing a wind charge) consumes a
+    // right-click that the vanilla client doesn't recognise. The client then falls through to the
+    // off-hand and the server would place/use the off-hand item too. When a main-hand action claims
+    // the interaction it stamps the current tick here; the packet handler drops any off-hand use for
+    // that same tick. Generic so future items (e.g. spears) can reuse it.
+    private long offHandUseSuppressedTick = Long.MIN_VALUE;
+
+    public void suppressOffHandUseThisTick() {
+        this.offHandUseSuppressedTick = this.level().getGameTime();
+    }
+
+    public boolean isOffHandUseSuppressed() {
+        return this.offHandUseSuppressedTick == this.level().getGameTime();
+    }
+    // Aincrad end - off-hand interaction suppression
+
     public ServerPlayer(MinecraftServer server, ServerLevel level, GameProfile gameProfile, ClientInformation clientInformation) {
         super(level, gameProfile);
         this.server = server;
