+    // Aincrad start - world dimensions remap
+    // Per stored dimension: loads fine = kept unchanged; fails to load = rebuilt from the datapack, else the vanilla preset.
+    private static <T> Dynamic<T> remapWorldDimensions(Dynamic<T> worldGenSettings, Registry<LevelStem> levelStemRegistry, HolderLookup.Provider registries) {
+        java.util.Optional<java.util.Map<Dynamic<T>, Dynamic<T>>> entries =
+            worldGenSettings.get("dimensions").orElseEmptyMap().getMapValues().result();
+        if (entries.isEmpty()) {
+            return worldGenSettings; // no stored dimensions: nothing to heal
+        }
+        // vanilla overworld/nether/end; the fallback when no datapack defines the dimension
+        WorldDimensions presetDimensions = net.minecraft.world.level.levelgen.presets.WorldPresets.createNormalWorldDimensions(registries);
+        java.util.Map<Dynamic<?>, Dynamic<?>> remapped = new java.util.LinkedHashMap<>();
+        boolean changed = false;
+        for (java.util.Map.Entry<Dynamic<T>, Dynamic<T>> entry : entries.get().entrySet()) {
+            if (LevelStem.CODEC.parse(entry.getValue()).result().isPresent()) {
+                remapped.put(entry.getKey(), entry.getValue()); // loads fine: keep unchanged
+                continue;
+            }
+            // fails to load: e.g. references content from a datapack that was removed
+            ResourceKey<LevelStem> key = ResourceKey.codec(net.minecraft.core.registries.Registries.LEVEL_STEM).parse(entry.getKey()).result().orElse(null);
+            if (key == null || key == LevelStem.OVERWORLD) {
+                remapped.put(entry.getKey(), entry.getValue()); // irreplaceable; kept for the strict parse to report
+                continue;
+            }
+            // rebuild source: the loaded datapack's definition first, else the vanilla preset
+            java.util.Optional<LevelStem> replacement = levelStemRegistry.getOptional(key).or(() -> presetDimensions.get(key));
+            if (replacement.isEmpty()) { // custom dimension with no source anywhere: drop it
+                LOGGER.error("world dimensions remap: no replacement source for unparseable dimension {}, dropping it", key.location());
+                changed = true;
+                continue;
+            }
+            LOGGER.error("world dimensions remap: rebuilding unparseable dimension {} from {}", key.location(),
+                levelStemRegistry.getOptional(key).isPresent() ? "the datapack registry" : "the normal world preset");
+            // encode the replacement back into level.dat's format, under the same key
+            remapped.put(entry.getKey(), new Dynamic<>(entry.getValue().getOps(), LevelStem.CODEC.encodeStart(entry.getValue().getOps(), replacement.get()).getOrThrow()));
+            changed = true;
+        }
+        // written back to disk on the next save, so the flag is only needed once
+        return changed ? worldGenSettings.set("dimensions", worldGenSettings.createMap(remapped)) : worldGenSettings;
+    }
+    // Aincrad end
+
     public String getName() {
         return "Anvil";
     }
