-        this.console.initWorld(serverLevel, primaryLevelData, primaryLevelData.worldGenOptions());
+
+        // Aincrad start - Run event and populators here on main thread to honor vanilla WorldInitEvent contract
+        // This ensures plugins can patch the worlds initialized by other plugins before any chunk generation occurs
+        // Twin code path at MinecraftServer:<line> - both branch from MinecraftServer.loadWorld0
+        // Both populators and worldborder must stay BEFORE WorldInitEvent
+        if (serverLevel.generator != null) {
+            serverLevel.getWorld().getPopulators().addAll(serverLevel.generator.getDefaultPopulators(serverLevel.getWorld()));
+        }
+
+        this.console.initWorldBorder(primaryLevelData, serverLevel);
+        org.bukkit.Bukkit.getPluginManager().callEvent(new org.bukkit.event.world.WorldInitEvent(serverLevel.getWorld()));
+        // Aincrad end
 
         serverLevel.setSpawnSettings(true);
         // Paper - Put world into worldlist before initing the world; move up
 
-        this.getServer().prepareLevel(serverLevel);
+        //this.getServer().prepareLevel(serverLevel);
+        io.papermc.paper.FeatureHooks.tickEntityManager(serverLevel); // SPIGOT-6526: Load pending entities so they are available to the API // Paper - chunk system
 
+        this.pluginManager.callEvent(new WorldLoadEvent(serverLevel.getWorld()));
         return serverLevel.getWorld();
     }
 
