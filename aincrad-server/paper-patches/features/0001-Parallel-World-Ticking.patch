diff --git a/src/main/java/org/evlis/ServerLevelTickExecutorThreadFactory.kt b/src/main/java/org/evlis/ServerLevelTickExecutorThreadFactory.kt
new file mode 100644
index 0000000000000000000000000000000000000000..d1e1658788e0e65c43ae0610b1fecdb474952c08
--- /dev/null
+++ b/src/main/java/org/evlis/ServerLevelTickExecutorThreadFactory.kt
@@ -0,0 +1,20 @@
+package org.evlis
+
+import ca.spottedleaf.moonrise.common.util.TickThread
+import java.util.concurrent.ThreadFactory
+
+class ServerLevelTickExecutorThreadFactory(private val worldName: String) : ThreadFactory {
+    override fun newThread(p0: Runnable): Thread {
+        val tickThread = TickThread.ServerLevelTickThread(p0, "serverlevel-tick-worker [$worldName]")
+
+        if (tickThread.isDaemon) {
+            tickThread.isDaemon = false
+        }
+
+        if (tickThread.priority != 5) {
+            tickThread.priority = 5
+        }
+
+        return tickThread
+    }
+}
